# FoodExpress Database Configuration
# Copy this file or set these as environment variables / JVM system properties

DB_HOST=localhost
DB_PORT=3306
DB_NAME=food_delivery_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# Optional dedicated SQL Console account (defaults to DB_USER/DB_PASSWORD if omitted)
SQL_CONSOLE_DB_USER=root
SQL_CONSOLE_DB_PASSWORD=your_mysql_password

# Disposable sandbox database for unrestricted DDL/DML experiments in SQL Console
SANDBOX_DB_NAME=food_delivery_sandbox
